<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for the e2e console. TEMPLATE ONLY: nothing installs or loads it.
  To use: replace __KIT__ (appstore-kit checkout) and __HOME__ (your home dir),
  copy to ~/Library/LaunchAgents/com.homeserver.e2e-console.plist, then
  `launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.homeserver.e2e-console.plist`.
  Credentials come from ~/.config/e2e/console.env (mode 600), never from this file.
  It listens on 127.0.0.1 only; the Cloudflare tunnel is the only way in.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.homeserver.e2e-console</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-m</string>
    <string>console</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__KIT__/e2e</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>__KIT__/e2e</string>
    <key>E2E_HOME</key>
    <string>__HOME__/e2e-runs</string>
    <key>E2E_CONSOLE_HOST</key>
    <string>127.0.0.1</string>
    <key>E2E_CONSOLE_PORT</key>
    <string>4020</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/e2e-console.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/e2e-console.log</string>
</dict>
</plist>
